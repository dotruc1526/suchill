FROM node:24-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY src ./src
COPY index-pvp.html vite.pvp.config.ts ./
RUN npx vite build --config vite.pvp.config.ts

FROM node:24-alpine
WORKDIR /app
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev
COPY server/*.js ./
COPY --from=frontend /app/output/pvp-trial/dist ./public
USER node
ENV NODE_ENV=production
ENV STATIC_DIR=/app/public
ENV PORT=3001
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD ["node", "healthcheck.js"]
CMD ["node", "server.js"]
