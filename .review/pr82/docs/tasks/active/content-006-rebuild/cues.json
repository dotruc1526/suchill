  "cues": [
    {
      "start": 0,
      "end": 2.833,
      "text": "Hello, SỬu đây!",
      "scene": 0
    },
    {
      "start": 2.833,
      "end": 5.283,
      "text": "Trước khi nói tới Điện Biên Phủ,",
      "scene": 1
    },
    {
      "start": 5.283,
      "end": 9.0,
      "text": "cho SỬu tua ngược thời gian một chút nha.",
      "scene": 2
    },
    {
      "start": 9.0,
      "end": 11.8,
      "text": "Đầu những năm 1950,",
      "scene": 3
    },
    {
      "start": 11.8,
      "end": 16.283,
      "text": "cuộc kháng chiến chống Pháp đã kéo dài nhiều năm rồi.",
      "scene": 4
    },
    {
      "start": 16.283,
      "end": 20.383,
      "text": "Và càng kéo dài thì chiến trường càng căng.",
      "scene": 5
    },
    {
      "start": 20.383,
      "end": 25.233,
      "text": "Về phía Pháp, vấn đề bắt đầu chất thành… một đống.",
      "scene": 6
    },
    {
      "start": 25.233,
      "end": 27.183,
      "text": "Chi phí chiến tranh lớn,",
      "scene": 7
    },
    {
      "start": 27.183,
      "end": 29.233,
      "text": "tình hình quân sự khó khăn,",
      "scene": 8
    },
    {
      "start": 29.233,
      "end": 33.717,
      "text": "mà thế chủ động thì cũng không còn dễ giữ như trước.",
      "scene": 9
    },
    {
      "start": 33.717,
      "end": 35.467,
      "text": "Nói đơn giản là:",
      "scene": 10
    },
    {
      "start": 35.467,
      "end": 39.033,
      "text": "cứ tiếp tục như vậy thì không ổn.",
      "scene": 11
    },
    {
      "start": 39.033,
      "end": 45.25,
      "text": "Thế là năm 1953, Pháp triển khai Kế hoạch Navarre.",
      "scene": 12
    },
    {
      "start": 45.25,
      "end": 47.333,
      "text": "Mục tiêu?",
      "scene": 13
    },
    {
      "start": 47.333,
      "end": 50.167,
      "text": "Tập trung lực lượng, giành lại thế chủ động",
      "scene": 14
    },
    {
      "start": 50.167,
      "end": 54.467,
      "text": "và tìm cách tạo ra một chuyển biến quân sự có lợi.",
      "scene": 15
    },
    {
      "start": 54.467,
      "end": 57.067,
      "text": "Nghe ổn đúng không?",
      "scene": 16
    },
    {
      "start": 57.067,
      "end": 58.733,
      "text": "Nhưng có một vấn đề nhỏ…",
      "scene": 17
    },
    {
      "start": 58.733,
      "end": 63.367,
      "text": "Phía Việt Nam cũng đang chủ động hoạt động trên nhiều hướng.",
      "scene": 18
    },
    {
      "start": 63.367,
      "end": 67.917,
      "text": "Quân Pháp phải điều lực lượng đi đối phó ở nhiều nơi.",
      "scene": 19
    },
    {
      "start": 67.917,
      "end": 70.067,
      "text": "Thành ra trên bản đồ lúc này,",
      "scene": 20
    },
    {
      "start": 70.067,
      "end": 73.683,
      "text": "mọi thứ bắt đầu… rối như tơ vò.",
      "scene": 21
    },
    {
      "start": 73.683,
      "end": 77.817,
      "text": "Và rồi có một cái tên bắt đầu xuất hiện.",
      "scene": 22
    },
    {
      "start": 77.817,
      "end": 80.333,
      "text": "Điện Biên Phủ.",
      "scene": 23
    },
    {
      "start": 80.333,
      "end": 83.45,
      "text": "Một thung lũng ở Tây Bắc.",
      "scene": 24
    },
    {
      "start": 83.45,
      "end": 85.883,
      "text": "Nhưng tại sao một nơi ở tận đây",
      "scene": 25
    },
    {
      "start": 85.883,
      "end": 89.6,
      "text": "lại trở thành tâm điểm của cả cuộc chiến?",
      "scene": 26
    },
    {
      "start": 89.6,
      "end": 93.389,
      "text": "Đó là chuyện của tập sau. Đi thôi!",
      "scene": 27
    }
  ]
}