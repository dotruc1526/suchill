{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/member5/*.test.ts",
    "test:component": "node --test tests/qa/component.test.mjs",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "test:authoring": "node docs/content/validate-mt68-authoring.mjs && node docs/content/validate-1972-authoring.mjs && node --test docs/content/authoring-validators.test.mjs",
    "test:e2e": "node scripts/member5/run-fixture-e2e.mjs",
    "test": "npm run test:unit && npm run test:component && npm run test:db && npm run test:authoring && npm run test:e2e",
    "quality": "npm run typecheck && npm run build && node scripts/member5/check-client-env.mjs --require-bundle && npm test && node scripts/member5/check-client-env.mjs --require-bundle"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
